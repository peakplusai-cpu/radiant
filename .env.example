# --- Required on Vercel (not needed for local development) ---
# Supabase project URL and service role key (Project Settings -> API). Server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Recommended ---
# Public site origin, used for canonical URLs, sitemap, Open Graph, and the LINE Login callback.
# Example: https://radiant-indol.vercel.app
NEXT_PUBLIC_SITE_URL=
SITE_ORIGIN=

# --- Optional (can also be entered in /admin/settings) ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_TOKEN=

# --- NewebPay 藍新金流（沒填則維持 LINE 確認付款，不會開卡機）---
# 只放在伺服器環境變數。不要用 NEXT_PUBLIC_ 前綴。
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
# production 才連 core.newebpay.com；留空或其他值連測試環境 ccore.newebpay.com
NEWEBPAY_ENV=
# 逗號分隔：credit,applepay,googlepay,linepay,webatm,vacc,cvs
# cvs 是超商代碼繳費。預設 credit,applepay
NEWEBPAY_METHODS=
# 超商取貨物流。填 off 關閉。預設開啟。
NEWEBPAY_CVS=
# ATM／超商代碼的繳費天數（1–180）。預設 3。取號成功後庫存保留到這一天。
NEWEBPAY_EXPIRE_DAYS=
# 每日清理逾時未付款訂單。Vercel Cron 會帶 Authorization: Bearer <這組值>
CRON_SECRET=

# Local-only: where the JSON data file lives (defaults to ./data/store.json)
RADIANT_DATA_FILE=
