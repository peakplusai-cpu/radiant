# --- Required on Vercel (not needed for local development) ---
# Supabase project URL and service role key (Project Settings -> API). Server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Recommended ---
# Public site origin, used for canonical URLs, sitemap, Open Graph, and the LINE Login callback.
# Example: https://radiant-indol.vercel.app
NEXT_PUBLIC_SITE_URL=
SITE_ORIGIN=

# --- Optional (can also be entered in /admin/settings) ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_MESSAGING_TOKEN=

# Local-only: where the JSON data file lives (defaults to ./data/store.json)
RADIANT_DATA_FILE=
